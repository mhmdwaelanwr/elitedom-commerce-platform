# =============================================================================
# Elitedom Store — Environment Variables Template
# Copy this file to .env and fill in real values: cp .env.example .env
# NEVER commit the .env file to version control.
# =============================================================================

# ---------- General ----------
ENVIRONMENT=development
DEBUG=true
# Generate with: openssl rand -hex 32. Template values are rejected in staging/production.
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
APP_NAME=Elitedom Store
APP_VERSION=1.0.0
ALLOWED_HOSTS=localhost,127.0.0.1,api.elitedom.store
# Comma-separated browser origins; do not use * when credentials are enabled.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- Observability ----------
# /metrics is intended for an internal Prometheus scraper; do not expose it
# directly to the public internet. Leave OTLP empty until a trusted collector
# (for example Jaeger) is deployed.
LOG_LEVEL=INFO
METRICS_ENABLED=true
OTEL_SERVICE_NAME=elitedom-fastapi
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACE_SAMPLE_RATIO=0.1
# Comma-separated proxy IPs allowed to pass X-Forwarded-For. Leave empty
# unless your reverse-proxy network has fixed, trusted addresses.
TRUSTED_PROXY_IPS=

# ---------- Next.js Storefront ----------
# This value is embedded in client-side JavaScript during the frontend image
# build. Leave it empty locally: development compose uses localhost. Production
# requires an explicit browser-reachable HTTPS API URL instead.
NEXT_PUBLIC_API_URL=

# ---------- PostgreSQL ----------
POSTGRES_USER=elitedom
POSTGRES_PASSWORD=CHANGE_ME
# Odoo keeps its native tables in POSTGRES_DB. The FastAPI store uses this
# separate database so its migration tables cannot collide with Odoo tables.
APP_POSTGRES_DB=elitedom_store
POSTGRES_DB=elitedom_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${APP_POSTGRES_DB}

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=elitedom_redis
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/2

# ---------- JWT Authentication ----------
# Must be different from SECRET_KEY.
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Odoo 17 ERP ----------
ODOO_URL=http://odoo:8069
ODOO_DB=elitedom_db
ODOO_API_USER=elitedom_api_user
ODOO_API_KEY=CHANGE_ME
# Generate independently; Odoo webhook endpoints fail closed until this is set.
ODOO_WEBHOOK_SECRET=CHANGE_ME_HMAC_SECRET

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_CURRENCY=egp
# Required before credit-card checkout is enabled.  The success URL may include
# Stripe's literal {CHECKOUT_SESSION_ID} placeholder; it is appended when absent.
STRIPE_CHECKOUT_SUCCESS_URL=https://store.example.com/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=https://store.example.com/checkout?payment=cancelled

# ---------- Algolia ----------
ALGOLIA_APP_ID=CHANGE_ME
ALGOLIA_API_KEY=CHANGE_ME
ALGOLIA_SEARCH_KEY=CHANGE_ME
ALGOLIA_INDEX_NAME=elitedom_products

# ---------- Twilio ----------
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_MESSAGING_SERVICE_SID=CHANGE_ME

# ---------- SendGrid ----------
SENDGRID_API_KEY=CHANGE_ME
SENDGRID_FROM_EMAIL=noreply@elitedom.store
SENDGRID_FROM_NAME=Elitedom Store

# ---------- Zeptomail ----------
ZEPTOMAIL_API_KEY=CHANGE_ME
ZEPTOMAIL_FROM_EMAIL=noreply@elitedom.store
ZEPTOMAIL_BOUNCE_ADDRESS=bounce@elitedom.store

# ---------- Zoho ----------
ZOHO_CLIENT_ID=CHANGE_ME
ZOHO_CLIENT_SECRET=CHANGE_ME
ZOHO_REFRESH_TOKEN=CHANGE_ME
ZOHO_ORG_ID=CHANGE_ME

# ---------- Hedera ----------
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.CHANGE_ME
HEDERA_OPERATOR_KEY=CHANGE_ME
HEDERA_TOPIC_ID=0.0.CHANGE_ME

# ---------- Docker Ports ----------
FASTAPI_PORT=8000
FRONTEND_PORT=3000
ODOO_PORT=8069
ODOO_LONGPOLL_PORT=8072
POSTGRES_PORT=5432
REDIS_PORT=6379
PORTAINER_PORT=9443
