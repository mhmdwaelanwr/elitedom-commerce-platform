# =============================================================================
# Elitedom Store — Environment Variables Template
# =============================================================================
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
APP_NAME=Elitedom Store
APP_VERSION=1.0.0
ALLOWED_HOSTS=localhost,127.0.0.1,api.elitedom.store
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
METRICS_ENABLED=true
# Required and non-placeholder when metrics are enabled in staging/production.
METRICS_BEARER_TOKEN=
OTEL_SERVICE_NAME=elitedom-fastapi
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACE_SAMPLE_RATIO=0.1
TRUSTED_PROXY_IPS=
# Production/staging configuration validation requires MFA=true and Redis limiting.
STAFF_MFA_REQUIRED=false
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_DEFAULT_PER_MINUTE=100
READINESS_TIMEOUT_SECONDS=2

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# When MEDIA_STORAGE_PROVIDER=s3, expose the same public CDN origin to Next Image.
NEXT_PUBLIC_MEDIA_URL=
NEXT_PUBLIC_DEMO_CATALOG_FALLBACK=false
# Public OAuth identifiers are embedded into the Next.js browser bundle at build time.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=
MEDIA_ROOT=/app/media
MEDIA_PUBLIC_PATH=/media
MEDIA_STORAGE_PROVIDER=local
# S3-compatible deployments require a public CDN/base URL. Credentials are read
# from the standard AWS credential chain or workload/instance role; never place
# credentials in source control.
MEDIA_CDN_BASE_URL=
S3_BUCKET=
S3_REGION=eu-central-1
S3_ENDPOINT_URL=
PRODUCT_IMAGE_MAX_BYTES=5242880

POSTGRES_USER=elitedom
POSTGRES_PASSWORD=CHANGE_ME
APP_POSTGRES_DB=elitedom_store
POSTGRES_DB=elitedom_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${APP_POSTGRES_DB}

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=elitedom_redis
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/2

JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Backend audience checks. Use the same provider identifiers exposed to the frontend.
GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=

ODOO_SYNC_ENABLED=false
ODOO_WEBHOOKS_ENABLED=false
ODOO_URL=http://odoo:8069
ODOO_DB=elitedom_db
ODOO_API_USER=elitedom_api_user
ODOO_API_KEY=CHANGE_ME
ODOO_WEBHOOK_SECRET=CHANGE_ME_HMAC_SECRET
ODOO_FASTAPI_WEBHOOK_URL=http://fastapi:8000/api/v1/webhooks/odoo
ODOO_CONNECTOR_TIMEOUT_SECONDS=10
ODOO_CONNECTOR_MAX_ATTEMPTS=8
ODOO_CONNECTOR_RETENTION_DAYS=30

# Legacy Stripe settings remain available during the Paymob migration window.
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_CURRENCY=egp
STRIPE_CHECKOUT_SUCCESS_URL=https://store.example.com/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=https://store.example.com/checkout?payment=cancelled

# Paymob Intention API and Unified Checkout. Keep disabled until sandbox keys,
# both payment method IDs, HMAC, and callback URLs are configured.
PAYMOB_ENABLED=false
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_CARD_PAYMENT_METHOD_ID=0
PAYMOB_WALLET_PAYMENT_METHOD_ID=0
PAYMOB_CURRENCY=EGP
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_UNIFIED_CHECKOUT_URL=https://accept.paymob.com/unifiedcheckout/
PAYMOB_NOTIFICATION_URL=https://api.example.com/api/v1/webhooks/paymob/transaction
PAYMOB_REDIRECTION_URL=https://store.example.com/checkout/payment-result
PAYMOB_TIMEOUT_SECONDS=15

ALGOLIA_APP_ID=CHANGE_ME
ALGOLIA_API_KEY=CHANGE_ME
ALGOLIA_SEARCH_KEY=CHANGE_ME
ALGOLIA_INDEX_NAME=elitedom_products
# Twilio is used for production SMS OTP delivery. In development, absent credentials
# return a debug code in the API response so the flow can be tested locally.
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_MESSAGING_SERVICE_SID=CHANGE_ME
SENDGRID_ENABLED=false
SENDGRID_API_KEY=CHANGE_ME
SENDGRID_FROM_EMAIL=noreply@elitedom.store
SENDGRID_FROM_NAME=Elitedom Store
ZEPTOMAIL_ENABLED=false
ZEPTOMAIL_API_KEY=CHANGE_ME
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_FROM_EMAIL=noreply@elitedom.store
ZEPTOMAIL_FROM_NAME=Elitedom Store
ZEPTOMAIL_BOUNCE_ADDRESS=bounce@elitedom.store
ZOHO_CLIENT_ID=CHANGE_ME
ZOHO_CLIENT_SECRET=CHANGE_ME
ZOHO_REFRESH_TOKEN=CHANGE_ME
ZOHO_ORG_ID=CHANGE_ME
HEDERA_ENABLED=false
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.CHANGE_ME
HEDERA_OPERATOR_KEY=CHANGE_ME
HEDERA_TOPIC_ID=0.0.CHANGE_ME
FASTAPI_WORKERS=2
CELERY_WORKER_CONCURRENCY=4
ADMIN_BIND_IP=127.0.0.1
FASTAPI_PORT=8000
FRONTEND_PORT=3000
ODOO_PORT=8069
ODOO_LONGPOLL_PORT=8072
POSTGRES_PORT=5432
REDIS_PORT=6379
PORTAINER_PORT=9443
