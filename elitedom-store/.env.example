# =============================================================================
# Elitedom Store — Environment Variables Template
# =============================================================================
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
APP_NAME=Elitedom Store
APP_VERSION=1.0.0
# Hardened staging/production compose maps the immutable Git SHA into APP_VERSION
# so /health/live can prove which release is actually deployed.
RELEASE_REF=development
ALLOWED_HOSTS=localhost,127.0.0.1,api.elitedom.store
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
METRICS_ENABLED=true
# Required and non-placeholder when metrics are enabled in staging/production.
METRICS_BEARER_TOKEN=
OTEL_SERVICE_NAME=elitedom-fastapi
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACE_SAMPLE_RATIO=0.1
# Sentry is opt-in. ENVIRONMENT is reused as the Sentry environment so the two
# values cannot drift. Set SENTRY_RELEASE to the deployed Git commit SHA.
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_ERROR_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.1
TRUSTED_PROXY_IPS=
# Production/staging configuration validation requires MFA=true and Redis limiting.
STAFF_MFA_REQUIRED=false
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_DEFAULT_PER_MINUTE=100
READINESS_TIMEOUT_SECONDS=2

# Public React/Vite browser configuration. VITE_* values are embedded at build time.
VITE_API_URL=http://localhost:8000/api/v1
VITE_SITE_URL=http://localhost:3000
VITE_MEDIA_URL=
VITE_DEMO_CATALOG_FALLBACK=false
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
MEDIA_ROOT=/app/media
MEDIA_PUBLIC_PATH=/media
MEDIA_STORAGE_PROVIDER=local
# S3-compatible deployments require a public CDN/base URL. Credentials are read
# from the standard AWS credential chain or workload/instance role; never place
# credentials in source control.
MEDIA_CDN_BASE_URL=
S3_BUCKET=
S3_REGION=eu-central-1
S3_ENDPOINT_URL=
PRODUCT_IMAGE_MAX_BYTES=5242880

POSTGRES_USER=elitedom
POSTGRES_PASSWORD=CHANGE_ME
APP_POSTGRES_DB=elitedom_store
POSTGRES_DB=elitedom_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${APP_POSTGRES_DB}

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=elitedom_redis
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/2

JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Backend audience checks. Use the same provider identifiers exposed to the frontend.
GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=

ODOO_SYNC_ENABLED=false
ODOO_WEBHOOKS_ENABLED=false
ODOO_URL=http://odoo:8069
ODOO_DB=elitedom_db
ODOO_API_USER=elitedom_api_user
ODOO_API_KEY=CHANGE_ME
ODOO_WEBHOOK_SECRET=CHANGE_ME_HMAC_SECRET
ODOO_FASTAPI_WEBHOOK_URL=http://fastapi:8000/api/v1/webhooks/odoo
ODOO_CONNECTOR_TIMEOUT_SECONDS=10
ODOO_CONNECTOR_MAX_ATTEMPTS=8
ODOO_CONNECTOR_RETENTION_DAYS=30

# Legacy Stripe settings remain available during the Paymob migration window.
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# Paymob is the primary payment gateway. Customer-facing labels should describe
# the payment method (for example Card or Wallet), not the gateway vendor.
PAYMOB_ENABLED=false
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_IFRAME_ID=
PAYMOB_BASE_URL=https://accept.paymob.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

SENDGRID_ENABLED=false
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

ZEPTOMAIL_ENABLED=false
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM_EMAIL=

SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

HEDERA_ENABLED=false
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_NETWORK=testnet

# Nginx Proxy Manager receives public traffic and proxies only to internal services.
NGINX_PROXY_INTERNAL_IP=172.28.0.10
