{
  "name": "elitedom-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-seo.mjs",
    "dev": "vite --host 0.0.0.0 --port 3000",
    "check:design-system": "node scripts/check-design-system.mjs",
    "check:figma-parity": "node scripts/check-figma-page-parity.mjs",
    "check:p19": "node scripts/check-p19-platform-parity.mjs",
    "check:ui-completeness": "node scripts/check-ui-completeness.mjs",
    "check:route-api-wiring": "node scripts/check-route-api-wiring.mjs && node scripts/check-commerce-api-wiring.mjs",
    "check:types": "tsc -b --pretty false",
    "verify": "npm run check:design-system && npm run lint && npm run check:types && npm run build",
    "prebuild": "node scripts/generate-seo.mjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "npm run check:figma-parity && npm run check:p19 && npm run check:ui-completeness && npm run check:route-api-wiring && eslint ."
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0"
  }
}
