<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_elitedom_connector" model="ir.ui.view">
        <field name="name">product.template.form.elitedom.connector</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Elitedom Store" name="elitedom_store">
                    <group>
                        <group string="Publishing">
                            <field name="elitedom_publish_to_store"/>
                            <field name="elitedom_brand"/>
                            <field name="elitedom_warranty_months"/>
                            <field name="elitedom_dropship_enabled"/>
                        </group>
                        <group string="Images">
                            <field name="elitedom_image_urls" placeholder="https://cdn.example.com/product.webp"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
